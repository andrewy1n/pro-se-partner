# Server-only — never exposed to the browser
BROWSER_USE_API_KEY=your-api-key-here

# Optional: Browser Use model for browser agents (bu-mini | bu-max; default: bu-max)
# BROWSER_USE_MODEL=bu-max

# Google AI Studio / Generative AI — required for Agent 1 intake classification (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Gemini model id for intake (default: gemini-2.5-flash)
# INTAKE_CLASSIFICATION_MODEL=gemini-2.5-flash

# Optional: set to 1 to log every Browser Use session poll (verbose; default is errors + milestones only)
# LOG_SESSION_POLL=1
