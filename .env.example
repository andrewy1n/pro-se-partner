# Server-only — never exposed to the browser
BROWSER_USE_API_KEY=your-api-key-here

# Vercel AI Gateway — required for Agent 1 intake classification (see https://vercel.com/docs/ai-gateway)
AI_GATEWAY_API_KEY=

# Optional override for intake classification (default: openai/gpt-5.4)
# INTAKE_CLASSIFICATION_MODEL=openai/gpt-5.4
